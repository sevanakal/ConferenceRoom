@page "/satis"
@model ConferenceRoom.Web.Pages.Satis.IndexModel
@using System.Globalization
@using ConferenceRoom.Web.Common
@using ConferenceRoom.Web.Sales
@*
    Satış bölümü açılış sayfası: satış personelinin göreceği yaklaşan seanslar; satışa açık seansın satış ekranına bağlantısı,
    üstte kendi satışlarının listesine (Satislarim.cshtml) bağlantı.
    Stil wwwroot/css/site.css.
*@
@{
    ViewData["Title"] = T["salesDesk.title"];
    var culture = CultureInfo.CurrentCulture;
}
<section class="sales-desk">
    <div class="sales-desk__top">
        <h1>@T["salesDesk.welcome", User.Identity?.Name ?? ""]</h1>
        <a class="btn-ghost" href="/satis/satislarim">@T["myOrders.title"]</a>
    </div>
    <p class="muted">@T["salesDesk.intro"]</p>

    @if (Model.Sessions.Count == 0)
    {
        <p>@T["board.empty"]</p>
    }
    else
    {
        <table class="sales-desk__table">
            <thead>
                <tr><th>@T["salesDesk.when"]</th><th>@T["salesDesk.event"]</th><th>@T["salesDesk.hall"]</th><th>@T["salesDesk.status"]</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Sessions)
                {
                    <tr>
                        <td>@DisplayTime.ToLocal(s.StartsAtUtc).ToString("d MMMM yyyy, HH:mm", culture)</td>
                        <td>@s.Title</td>
                        <td>@s.HallName</td>
                        <td>@T[$"board.badge{s.Badge}", s.SalesStartUtc is { } start ? DisplayTime.ToLocal(start).ToString("d MMMM HH:mm", culture) : ""]</td>
                        <td>
                            @if (SalesDesk.IsOpen(s.Badge))
                            {
                                <a class="btn-primary" href="/satis/seans/@s.SessionId">@T["sales.open"]</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
