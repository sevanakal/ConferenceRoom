@page
@model IndexModel
@{
    ViewData["Title"] = T["home.title"];
}
<section class="hero">
    <h1>@T["home.title"]</h1>
    <p class="lead">@T["home.intro"]</p>
</section>

<section class="card" aria-labelledby="status-title">
    <h2 id="status-title">@T["home.statusTitle"]</h2>
    <dl class="status-list">
        <dt>@T["home.database"]</dt>
        <dd class="@(Model.DatabaseConnected ? "ok" : "fail")">
            @(Model.DatabaseConnected ? T["home.databaseOk"] : T["home.databaseFail"])
        </dd>
        @if (Model.OrganizationName is not null)
        {
            <dt>@T["home.organization"]</dt>
            <dd>@Model.OrganizationName</dd>
        }
    </dl>
</section>
