@page "/yonetim/etkinlikler/turler"
@model ConferenceRoom.Web.Pages.Yonetim.Etkinlikler.Turler.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = T["eventTypes.title"];
    ViewData["AdminNav"] = "events";
}
<header class="page-head">
    <div>
        <a class="back-link" href="/yonetim/etkinlikler">← @T["events.title"]</a>
        <h1>@T["eventTypes.title"]</h1>
        <p>@T["eventTypes.intro"]</p>
    </div>
    <a class="btn-primary btn-inline" href="/yonetim/etkinlikler/turler/duzenle">@T["eventTypes.new"]</a>
</header>

<partial name="_Flash" model="Model.Flash" />

<div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th scope="col">@T["eventTypes.name"]</th>
                <th scope="col">@T["events.saleMode"]</th>
                <th scope="col">@T["events.requiresApproval"]</th>
                <th scope="col" class="num">@T["eventTypes.eventCount"]</th>
                <th scope="col">@T["halls.status"]</th>
                <th scope="col"><span class="visually-hidden">@T["admin.edit"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var type in Model.Types)
            {
                <tr data-active="@(type.IsActive ? "true" : "false")">
                    <td><a class="row-title" href="/yonetim/etkinlikler/turler/duzenle/@type.Id">@type.Name</a></td>
                    <td>@T[$"events.saleMode{type.SaleMode}"]</td>
                    <td>@(type.RequiresApproval ? T["events.yes"] : T["events.no"])</td>
                    <td class="num">@type.EventCount</td>
                    <td><span class="status @(type.IsActive ? "status-on" : "status-off")">@(type.IsActive ? T["halls.active"] : T["halls.inactive"])</span></td>
                    <td class="actions"><a href="/yonetim/etkinlikler/turler/duzenle/@type.Id">@T["admin.edit"]</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
