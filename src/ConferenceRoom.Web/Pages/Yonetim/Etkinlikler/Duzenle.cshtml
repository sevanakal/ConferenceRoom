@page "/yonetim/etkinlikler/duzenle/{id:int?}"
@model ConferenceRoom.Web.Pages.Yonetim.Etkinlikler.DuzenleModel
@using ConferenceRoom.Domain.Events
@using ConferenceRoom.Web.Common
@using ConferenceRoom.Web.Events
@{
    Layout = "_AdminLayout";
    var title = Model.Id is null ? T["events.newTitle"] : T["events.editTitle"];
    ViewData["Title"] = title;
    ViewData["AdminNav"] = "events";
    string? Invalid(string key) => Model.Errors.ContainsKey(key) ? "true" : null;
    const string LocalFormat = "yyyy-MM-ddTHH:mm";
}
@functions {
    // Alanın altındaki hata satırı (yoksa hiçbir şey yazmaz).
    private void Error(string key)
    {
        if (Model.Errors.TryGetValue(key, out var error))
        {
            <p class="field-error">@T[error]</p>
        }
    }

    // Bir seans satırı. key: satırın form anahtarı (SessionRows[key]); "+" ile eklenen satırlar
    // sayfa sonundaki şablondan "__key__" yerine yeni anahtar konarak üretilir.
    private void SessionRow(string key, DuzenleModel.SessionInput row, string? errorKey)
    {
        var prefix = $"SessionRows[{key}]";
        var id = $"Session_{key}";
        // Hatalı alan işaretlenir: kapı saati hatasında kapı alanı, diğerlerinde tarih ve başlangıç.
        var doorsInvalid = errorKey == "events.doorsAfterStart" ? "true" : null;
        var invalid = errorKey is null || doorsInvalid is not null ? null : "true";
        <div class="session-row" data-session-id="@row.Id">
            <input type="hidden" name="SessionRows.Index" value="@key" />
            @if (row.Id is not null)
            {
                <input type="hidden" name="@(prefix).Id" value="@row.Id" />
            }
            <div class="field">
                <label for="@(id)_Date">@T["events.sessionDate"]</label>
                <input id="@(id)_Date" name="@(prefix).Date" type="date" value="@row.Date?.ToString("yyyy-MM-dd")" aria-invalid="@invalid" />
            </div>
            <div class="field">
                <label for="@(id)_Start">@T["events.sessionStart"]</label>
                <input id="@(id)_Start" name="@(prefix).Start" type="time" value="@row.Start?.ToString("HH:mm")" aria-invalid="@invalid" />
            </div>
            <div class="field">
                <label for="@(id)_End">@T["events.sessionEnd"]</label>
                <input id="@(id)_End" name="@(prefix).End" type="time" value="@row.End?.ToString("HH:mm")" />
            </div>
            <div class="field">
                <label for="@(id)_Doors">@T["events.doorsOpen"]</label>
                <input id="@(id)_Doors" name="@(prefix).DoorsOpen" type="time" value="@row.DoorsOpen?.ToString("HH:mm")" aria-invalid="@doorsInvalid" />
            </div>
            <button type="button" class="session-remove" data-remove-session aria-label="@T["events.removeSession"]" title="@T["events.removeSession"]">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
            @if (row.Id is { } sessionId && Model.PlanVersions.TryGetValue(sessionId, out var version))
            {
                <p class="field-hint session-meta">@T["events.sessionPlan", version]</p>
            }
            @if (errorKey is not null)
            {
                <p class="field-error session-meta">@T[errorKey]</p>
            }
        </div>
    }
}
<header class="page-head">
    <div>
        <a class="back-link" href="/yonetim/etkinlikler">← @T["events.title"]</a>
        <h1>@title</h1>
    </div>
    @* Kayıtlı etkinlikte, fiyatlandırma yetkisi olana koltuk ayarları (kategori, fiyat, online koltuklar) bağlantısı. *@
    @if (Model.Id is not null && User.HasClaim(ConferenceRoom.Web.Auth.AppClaims.Permission, ConferenceRoom.Domain.Accounts.Permissions.PricingManage))
    {
        <div class="form-actions">
            <a class="btn-secondary" href="/yonetim/fiyatlandirma/@Model.Id">@T["pricing.openSeats"]</a>
        </div>
    }
</header>

<partial name="_Flash" model="Model.Flash" />
@if (Model.Errors.Count > 0)
{
    <div class="form-alert" role="alert">@T["admin.formErrors"]</div>
}

@* ---- Etkinlik bilgileri, seanslar ve satış kuralları: tek form, tek kayıt ---- *@
<form method="post" class="form-card" enctype="multipart/form-data" novalidate>
    <div class="field">
        <label for="Input_Title">@T["events.eventTitle"]</label>
        <input id="Input_Title" name="Input.Title" value="@Model.Input.Title" maxlength="200" required aria-invalid="@Invalid("Title")" />
        @{ Error("Title"); }
    </div>
    <div class="form-row">
        <div class="field">
            <label for="Input_EventTypeId">@T["events.type"]</label>
            @* Yeni etkinlikte tür değişince satış türü ve onay kutusu türün varsayılanına çekilir (sayfa sonundaki betik). *@
            <select id="Input_EventTypeId" name="Input.EventTypeId" aria-invalid="@Invalid("EventTypeId")" data-apply-defaults="@(Model.Id is null ? "true" : null)">
                @foreach (var type in Model.Types.Where(t => t.IsActive || t.Id == Model.Input.EventTypeId))
                {
                    <option value="@type.Id" selected="@(type.Id == Model.Input.EventTypeId)" data-sale-mode="@type.SaleMode" data-approval="@(type.RequiresApproval ? "true" : "false")">@type.Name</option>
                }
            </select>
            @{ Error("EventTypeId"); }
            <p class="field-hint"><a href="/yonetim/etkinlikler/turler">@T["eventTypes.manage"]</a></p>
        </div>
        <div class="field">
            <label for="Input_HallId">@T["events.hall"]</label>
            <select id="Input_HallId" name="Input.HallId" aria-invalid="@Invalid("HallId")">
                @foreach (var hall in Model.Halls.Where(h => h.IsActive || h.Id == Model.Input.HallId))
                {
                    <option value="@hall.Id" selected="@(hall.Id == Model.Input.HallId)">@hall.Name</option>
                }
            </select>
            @{ Error("HallId"); }
        </div>
    </div>
    <div class="field">
        <label for="Input_Organizer">@T["events.organizer"]</label>
        <input id="Input_Organizer" name="Input.Organizer" value="@Model.Input.Organizer" maxlength="200" />
        <p class="field-hint">@T["events.organizerHint"]</p>
    </div>
    <div class="field">
        <label for="Input_Description">@T["events.description"]</label>
        <textarea id="Input_Description" name="Input.Description" maxlength="4000" rows="5">@Model.Input.Description</textarea>
    </div>
    @* Afiş: solda önizleme (kayıtlı afiş ya da yeni seçilen dosya), sağda dosya seçimi. Önizlemeyi sayfa sonundaki betik günceller. *@
    @{ var savedPoster = Model.PosterFileName is null ? null : PosterStore.Url(Model.PosterFileName); }
    <div class="field">
        <label for="Input_Poster">@T["events.poster"]</label>
        <div class="poster-picker">
            <div class="poster-thumb" id="poster-thumb" data-saved="@savedPoster">
                <img id="poster-img" src="@savedPoster" alt="@T["events.posterPreview"]" hidden="@(savedPoster is null)" />
                <span class="poster-empty" id="poster-empty" hidden="@(savedPoster is not null)">@T["events.posterNone"]</span>
            </div>
            <div class="poster-controls">
                <input id="Input_Poster" name="Input.Poster" type="file" accept="image/jpeg,image/png,image/webp" aria-invalid="@Invalid("Poster")" />
                <div class="poster-selected" id="poster-selected" hidden>
                    <button type="button" class="btn-ghost" id="poster-clear">@T["events.posterClear"]</button>
                </div>
                @if (savedPoster is not null)
                {
                    <label class="check">
                        <input type="checkbox" id="Input_RemovePoster" name="Input.RemovePoster" value="true" />
                        <span>@T["events.removePoster"]</span>
                    </label>
                }
                <p class="field-hint">@T["events.posterHint"]</p>
                @{ Error("Poster"); }
            </div>
        </div>
    </div>

    @* ---- Seanslar: dinamik satırlar, "+" ile eklenir ---- *@
    <h2 class="form-section-title" id="seanslar">@T["events.sessions"]</h2>
    <p class="field-hint">@T["events.sessionsHint"]</p>
    @{ Error("Sessions"); }
    <div class="session-list" id="session-list">
        @for (var i = 0; i < Model.SessionRows.Count; i++)
        {
            SessionRow(i.ToString(System.Globalization.CultureInfo.InvariantCulture), Model.SessionRows[i], Model.Errors.GetValueOrDefault($"Session.{i}"));
        }
        @foreach (var removed in Model.RemovedSessionIds)
        {
            <input type="hidden" name="RemovedSessionIds" value="@removed" />
        }
    </div>
    <div>
        <button type="button" class="btn-secondary session-add" id="session-add">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            @T["events.addSession"]
        </button>
    </div>
    <template id="session-template">@{ SessionRow("__key__", new DuzenleModel.SessionInput(), null); }</template>

    <h2 class="form-section-title">@T["events.salesRules"]</h2>
    <partial name="_SaleModeChoices" model="Model.Input.SaleMode" />
    <div class="check-group">
        <label class="check">
            <input type="checkbox" id="Input_RequiresApproval" name="Input.RequiresApproval" value="true" @(Model.Input.RequiresApproval ? "checked" : null) />
            <span>@T["events.requiresApproval"]</span>
        </label>
        <input type="hidden" name="Input.RequiresApproval" value="false" />
        <p class="field-hint">@T["events.requiresApprovalHint"]</p>
    </div>
    <div class="check-group">
        <label class="check">
            <input type="checkbox" name="Input.OnlineEnabled" value="true" @(Model.Input.OnlineEnabled ? "checked" : null) />
            <span>@T["events.onlineEnabled"]</span>
        </label>
        <input type="hidden" name="Input.OnlineEnabled" value="false" />
        <p class="field-hint">@T["events.onlineEnabledHint"]</p>
    </div>
    <div class="form-row">
        <div class="field">
            <label for="Input_SalesStart">@T["events.salesStart"]</label>
            <input id="Input_SalesStart" name="Input.SalesStart" type="datetime-local" value="@Model.Input.SalesStart?.ToString(LocalFormat)" />
            <p class="field-hint">@T["events.salesStartHint"]</p>
        </div>
        <div class="field">
            <label for="Input_SalesEnd">@T["events.salesEnd"]</label>
            <input id="Input_SalesEnd" name="Input.SalesEnd" type="datetime-local" value="@Model.Input.SalesEnd?.ToString(LocalFormat)" aria-invalid="@Invalid("SalesEnd")" />
            <p class="field-hint">@T["events.salesEndHint"]</p>
            @{ Error("SalesEnd"); }
        </div>
    </div>
    <div class="field">
        <label for="Input_MaxTicketsPerPerson">@T["events.maxTickets"]</label>
        <input id="Input_MaxTicketsPerPerson" name="Input.MaxTicketsPerPerson" type="number" min="1" max="100" value="@Model.Input.MaxTicketsPerPerson" aria-invalid="@Invalid("MaxTicketsPerPerson")" />
        <p class="field-hint">@T["events.maxTicketsHint"]</p>
        @{ Error("MaxTicketsPerPerson"); }
    </div>

    <h2 class="form-section-title">@T["events.publishing"]</h2>
    <div class="field">
        <label for="Input_Status">@T["halls.status"]</label>
        <select id="Input_Status" name="Input.Status" aria-invalid="@Invalid("Status")">
            @foreach (var status in Enum.GetValues<EventStatus>())
            {
                <option value="@status" selected="@(status == Model.Input.Status)">@T[$"events.state{status}"]</option>
            }
        </select>
        <p class="field-hint">@T["events.statusHint"]</p>
        @{ Error("Status"); }
    </div>

    <div class="form-actions">
        <button type="submit" class="btn-primary btn-inline">@T["admin.save"]</button>
        <a class="btn-secondary" href="/yonetim/etkinlikler">@T["admin.cancel"]</a>
    </div>
</form>

<script>
    // Yeni etkinlikte tür seçilince satış türü ve onay kuralı türün varsayılanına çekilir (sunucudaki OnGet ile aynı kural).
    (function () {
        var select = document.getElementById("Input_EventTypeId");
        if (!select || !select.dataset.applyDefaults) return;
        select.addEventListener("change", function () {
            var option = select.options[select.selectedIndex];
            var radio = document.querySelector('input[name="Input.SaleMode"][value="' + option.dataset.saleMode + '"]');
            if (radio) radio.checked = true;
            document.getElementById("Input_RequiresApproval").checked = option.dataset.approval === "true";
        });
    })();

    // Seans satırları: "+" şablondan yeni satır ekler; kaldırılan kayıtlı seansın kimliği gizli alana yazılır, kayıtta silinir.
    (function () {
        var list = document.getElementById("session-list");
        var template = document.getElementById("session-template");
        var next = 0;
        document.getElementById("session-add").addEventListener("click", function () {
            var key = "n" + (next++);
            var holder = document.createElement("div");
            holder.innerHTML = template.innerHTML.replace(/__key__/g, key);
            var row = holder.firstElementChild;
            list.appendChild(row);
            row.querySelector("input[type=date]").focus();
        });
        list.addEventListener("click", function (e) {
            var button = e.target.closest("[data-remove-session]");
            if (!button) return;
            var row = button.closest(".session-row");
            if (row.dataset.sessionId) {
                var removed = document.createElement("input");
                removed.type = "hidden";
                removed.name = "RemovedSessionIds";
                removed.value = row.dataset.sessionId;
                list.appendChild(removed);
            }
            row.remove();
        });
    })();

    // Afiş önizlemesi: seçilen dosya hemen gösterilir; "Seçimi kaldır" kayıtlı afişe döner.
    // "Afişi kaldır" işaretliyken yeni dosya seçilmemişse boş kutu gösterilir.
    (function () {
        var input = document.getElementById("Input_Poster");
        var thumb = document.getElementById("poster-thumb");
        var img = document.getElementById("poster-img");
        var empty = document.getElementById("poster-empty");
        var selected = document.getElementById("poster-selected");
        var remove = document.getElementById("Input_RemovePoster");
        var objectUrl = null;
        function show(src) {
            img.hidden = !src;
            empty.hidden = !!src;
            if (src) img.src = src; else img.removeAttribute("src");
        }
        function refresh() {
            if (objectUrl) { URL.revokeObjectURL(objectUrl); objectUrl = null; }
            var file = input.files && input.files[0];
            selected.hidden = !file;
            if (file) {
                objectUrl = URL.createObjectURL(file);
                show(objectUrl);
            } else {
                show(remove && remove.checked ? null : thumb.dataset.saved);
            }
        }
        img.addEventListener("error", function () { show(null); });   // görsel olmayan dosya
        input.addEventListener("change", refresh);
        if (remove) remove.addEventListener("change", refresh);
        document.getElementById("poster-clear").addEventListener("click", function () {
            input.value = "";
            refresh();
            input.focus();
        });
    })();
</script>
