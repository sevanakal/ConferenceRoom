@page "/yonetim"
@model ConferenceRoom.Web.Pages.Yonetim.IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@*
    Yönetim paneli: karşılama ve bölüm kartları. Kartlar sağ üstteki tutamaçtan sürüklenip yeniden sıralanır
    (wwwroot/js/panel-duzen.js); sıra kullanıcı başına saklanır (IndexModel.OnPostOrderAsync).
*@
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = T["admin.title"];
    ViewData["AdminNav"] = "dashboard";
    // Bölüm kartlarının simgeleri (yetki kodu ya da ek bölüm anahtarına göre). Bölüm eklendikçe buraya da eklenir.
    var icons = new Dictionary<string, string>
    {
        ["halls.manage"] = "M3 21V8l9-5 9 5v13M7 21v-6h10v6M7 11h.01M12 11h.01M17 11h.01",
        ["events.manage"] = "M4 6h16v15H4zM4 10h16M8 3v5M16 3v5",
        ["pricing.manage"] = "M3 12V4h8l10 10-8 8L3 12ZM7.5 7.5h.01",
        ["sales.view"] = "M4 20V10M10 20V4M16 20v-8M22 20H2",
        ["sales.notify"] = "M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.9 1.9 0 0 0 3.4 0",
        ["users.manage"] = "M16 20v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 20v-1a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8",
        ["sales.sell"] = "M3 7h18v4a2 2 0 0 0 0 4v4H3v-4a2 2 0 0 0 0-4V7ZM14 7v12",
        ["salesScope"] = "M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6l8-3ZM9 12l2 2 4-4",
    };
    // Kullanıma açılmış bölümlerin adresleri. Burada olmayan bölüm "Yakında" görünür.
    var links = new Dictionary<string, string>
    {
        ["halls.manage"] = "/yonetim/salonlar",
        ["events.manage"] = "/yonetim/etkinlikler",
        ["pricing.manage"] = "/yonetim/fiyatlandirma",
        ["sales.view"] = "/yonetim/satislar",
        ["sales.notify"] = "/yonetim/bildirimler",
        ["users.manage"] = "/yonetim/kullanicilar",
        ["salesScope"] = "/yonetim/satis-yetkileri",
    };
}
<section class="admin-hero">
    <h1>@T["admin.welcome", Model.FullName]</h1>
    <p>@T["admin.intro"]</p>
    @if (Model.RoleNames.Count > 0)
    {
        <p class="role-list"><span>@T["admin.roles"]:</span>
            @foreach (var role in Model.RoleNames)
            {
                <span class="role-chip">@role</span>
            }
        </p>
    }
</section>

<div class="section-tools">
    <p id="orderStatus" class="section-tools__hint" role="status">@T["admin.orderHint"]</p>
    <button type="button" class="btn-link" id="resetOrder" hidden="@(!Model.HasCustomOrder)">@T["admin.orderReset"]</button>
</div>
<ul class="section-grid" id="sectionGrid" data-save-url="/yonetim?handler=Order" data-token="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken"
    data-saved="@T["admin.orderSaved"]" data-failed="@T["admin.orderFailed"]">
    @foreach (var (key, textPrefix, allowed) in Model.Sections)
    {
        <li class="section-card" data-allowed="@(allowed ? "true" : "false")" data-key="@key">
            <button type="button" class="drag-handle" aria-label="@T["admin.orderHandle", T[$"{textPrefix}.name"]]" title="@T["admin.orderHandleTitle"]">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5h.01M15 5h.01M9 12h.01M15 12h.01M9 19h.01M15 19h.01" /></svg>
            </button>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@icons.GetValueOrDefault(key, "M4 4h16v16H4z")" /></svg>
            @if (allowed && links.TryGetValue(key, out var url))
            {
                <h2><a class="stretched" href="@url">@T[$"{textPrefix}.name"]</a></h2>
            }
            else
            {
                <h2>@T[$"{textPrefix}.name"]</h2>
            }
            <p>@T[$"{textPrefix}.description"]</p>
            <div class="section-card__foot">
                <span class="pill @(allowed ? "pill-ok" : "pill-locked")">@(allowed ? T["admin.allowed"] : T["admin.locked"])</span>
                @if (allowed && !links.ContainsKey(key))
                {
                    <span class="pill pill-soft">@T["admin.soon"]</span>
                }
            </div>
        </li>
    }
</ul>

@section Scripts {
    <script src="~/js/panel-duzen.js" asp-append-version="true"></script>
}
