@page "/yonetim/salonlar/duzenle/{id:int?}"
@model ConferenceRoom.Web.Pages.Yonetim.Salonlar.DuzenleModel
@using ConferenceRoom.Web.Common
@{
    Layout = "_AdminLayout";
    var title = Model.Id is null ? T["halls.newTitle"] : T["halls.editTitle"];
    ViewData["Title"] = title;
    ViewData["AdminNav"] = "halls";
}
<header class="page-head">
    <div>
        <a class="back-link" href="/yonetim/salonlar">← @T["halls.title"]</a>
        <h1>@title</h1>
    </div>
    @if (Model.Id is not null)
    {
        <a class="btn-secondary" href="/yonetim/salonlar/@Model.Id/kroki">@T["halls.openPlan"]</a>
    }
</header>

<form method="post" class="form-card" novalidate>
    <div class="field">
        <label for="Input_Name">@T["halls.name"]</label>
        <input id="Input_Name" name="Input.Name" value="@Model.Input.Name" maxlength="200" required
               aria-invalid="@(Model.Errors.ContainsKey("Name") ? "true" : null)" />
        @if (Model.Errors.TryGetValue("Name", out var nameError))
        {
            <p class="field-error">@T[nameError]</p>
        }
    </div>
    <div class="field">
        <label for="Input_Description">@T["halls.description"]</label>
        <input id="Input_Description" name="Input.Description" value="@Model.Input.Description" maxlength="1000" />
        <p class="field-hint">@T["halls.descriptionHint"]</p>
    </div>

    <div class="check-group">
        <label class="check">
            <input type="checkbox" name="Input.IsActive" value="true" @(Model.Input.IsActive ? "checked" : null) />
            <span>@T["halls.isActive"]</span>
        </label>
        @* İşaretsiz kutu hiçbir değer göndermez; bu gizli alan o durumda "false" gönderir (işaretliyse ilk değer "true" kazanır). *@
        <input type="hidden" name="Input.IsActive" value="false" />
        <p class="field-hint">@T["halls.isActiveHint"]</p>
    </div>

    @if (Model.Id is null)
    {
        <p class="field-hint">@T["halls.newHint"]</p>
    }
    <div class="form-actions">
        <button type="submit" class="btn-primary btn-inline">@(Model.Id is null ? T["halls.createAndDraw"] : T["admin.save"])</button>
        <a class="btn-secondary" href="/yonetim/salonlar">@T["admin.cancel"]</a>
    </div>
</form>

@if (Model.Id is not null)
{
    <section class="versions">
        <h2>@T["halls.versions"]</h2>
        <p class="muted">@T["halls.versionsHint"]</p>
        @if (Model.Versions.Count == 0)
        {
            <p class="muted">@T["halls.noPlan"]</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col">@T["halls.version"]</th>
                            <th scope="col" class="num">@T["halls.capacity"]</th>
                            <th scope="col">@T["halls.savedAt"]</th>
                            <th scope="col"><span class="visually-hidden">@T["halls.openPlan"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var version in Model.Versions)
                        {
                            var isLatest = version.Version == Model.Versions[0].Version;
                            <tr>
                                <td>
                                    @T["halls.versionN", version.Version]
                                    @if (isLatest)
                                    {
                                        <span class="pill pill-ok">@T["halls.current"]</span>
                                    }
                                </td>
                                <td class="num">@version.Capacity.ToString("N0")</td>
                                <td>@DisplayTime.Format(version.CreatedAtUtc) · @version.SavedBy</td>
                                <td class="actions">
                                    <a href="/yonetim/salonlar/@Model.Id/kroki@(isLatest ? "" : $"?surum={version.Version}")">@(isLatest ? T["halls.openPlan"] : T["halls.openVersion"])</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
