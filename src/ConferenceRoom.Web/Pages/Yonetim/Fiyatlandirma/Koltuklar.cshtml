@page "/yonetim/fiyatlandirma/{id:int}"
@model ConferenceRoom.Web.Pages.Yonetim.Fiyatlandirma.KoltuklarModel
@using System.Globalization
@using System.Text.Json
@*
    Etkinlik koltuk ayarları: tam ekran, yönetim şablonu kullanılmaz (tuval tüm alanı kaplar).
    İşleyiş wwwroot/js/koltuk-ayarlari.js (ortak çizim kroki-cizim.js), stil kroki-editor.css (ortak çerçeve) + koltuk-ayarlari.css.
    Durağan metinler burada dil dosyasından yazılır; panel metinlerini ekran kendisi üretir ("seatEditor" bölümü, #editorConfig içinde).
*@
@{
    Layout = null;
    string Tx(string key) => T["seatEditor." + key];
    // JSON'un </script> ile sayfayı kırmaması için.
    static string Safe(string json) => json.Replace("</", "<\\/", StringComparison.Ordinal);
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@Model.EventTitle · @Tx("appName") · @T["app.name"]</title>
    <link rel="stylesheet" href="~/css/kroki-editor.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/koltuk-ayarlari.css" asp-append-version="true" />
</head>
<body>
@if (Model.PlanJson is null)
{
    @* Seansı olmayan etkinlikte hangi krokinin gösterileceği belli değil. *@
    <main class="seat-empty">
        <h1>@Model.EventTitle</h1>
        <p>@T["seatMap.noSessions"]</p>
        <p><a href="/yonetim/fiyatlandirma">← @T["pricing.title"]</a></p>
    </main>
}
else
{
<div class="app seat-app">
    <header class="top">
        <a class="ibtn back" href="/yonetim/fiyatlandirma" title="@Tx("back")" aria-label="@Tx("back")"><svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg></a>
        <div class="brand"><b>@Model.EventTitle</b><span>@Model.HallName</span><span id="saveState" role="status"></span></div>
        <div class="tabs" id="tabs" role="tablist"></div>
        <div class="spacer"></div>
        <div class="group">
            <button class="ibtn" id="toolSelect" aria-pressed="true" title="@Tx("toolSelect")" aria-label="@Tx("toolSelect")"><svg viewBox="0 0 24 24"><path d="M5 3l14 8-6 2-3 6z"/></svg></button>
            <button class="ibtn" id="toolHand" aria-pressed="false" title="@Tx("toolHand")" aria-label="@Tx("toolHand")"><svg viewBox="0 0 24 24"><path d="M8 13V5a1.5 1.5 0 0 1 3 0v6M11 11V4a1.5 1.5 0 0 1 3 0v7M14 11V5.5a1.5 1.5 0 0 1 3 0V14a6 6 0 0 1-6 6h-1a6 6 0 0 1-5-2.7L3 14a1.5 1.5 0 0 1 2.5-1.6L8 15"/></svg></button>
        </div>
        <div class="group">
            <button class="ibtn" id="undoBtn" title="@Tx("undo")" aria-label="@Tx("undo")"><svg viewBox="0 0 24 24"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg></button>
            <button class="ibtn" id="redoBtn" title="@Tx("redo")" aria-label="@Tx("redo")"><svg viewBox="0 0 24 24"><path d="m15 14 5-5-5-5"/><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13"/></svg></button>
        </div>
        <div class="group">
            <button class="ibtn" id="zoomOut" title="@Tx("zoomOut")" aria-label="@Tx("zoomOut")"><svg viewBox="0 0 24 24"><path d="M5 12h14"/></svg></button>
            <span class="zoomval" id="zoomVal">100%</span>
            <button class="ibtn" id="zoomIn" title="@Tx("zoomIn")" aria-label="@Tx("zoomIn")"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></button>
            <button class="ibtn" id="fitBtn" title="@Tx("fit")" aria-label="@Tx("fit")"><svg viewBox="0 0 24 24"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg></button>
            <button class="ibtn paneltoggle" id="panelBtn" title="@Tx("panel")" aria-label="@Tx("panel")"><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM14 5v14"/></svg></button>
        </div>
        <button class="savebtn" id="saveBtn" title="@Tx("saveTitle")"><svg viewBox="0 0 24 24"><path d="M5 4h11l3 3v13H5zM8 4v5h7V4M8 20v-6h8v6"/></svg>@Tx("save")</button>
        @if (Model.PlanVersionCount > 1)
        {
            <p class="notice">@Tx("multiVersions")</p>
        }
    </header>

    <div class="main">
        <div class="canvas-wrap">
            <div id="stage"></div>
            <div class="hud"><span id="hoverInfo" hidden></span></div>
        </div>
        <aside class="panel" id="panel">
            <section class="sec" id="selSec"></section>
            <section class="sec" id="catSec"></section>
            <section class="sec" id="onlineSec"></section>
            <section class="sec" id="statSec"></section>
        </aside>
    </div>
</div>
<div class="toast" id="toast" role="status" hidden></div>

<script type="application/json" id="editorConfig">@Html.Raw(Safe(JsonSerializer.Serialize(Model.EditorConfig)))</script>
<script type="application/json" id="planData">@Html.Raw(Safe(Model.PlanJson))</script>
<script type="application/json" id="mapData">@Html.Raw(Safe(Model.MapJson))</script>
<script src="~/lib/konva/konva.min.js" asp-append-version="true"></script>
<script src="~/js/kroki-cizim.js" asp-append-version="true"></script>
<script src="~/js/koltuk-ayarlari.js" asp-append-version="true"></script>
}
</body>
</html>
