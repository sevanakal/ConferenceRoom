@page "/yonetim/fiyatlandirma/{id:int}"
@model ConferenceRoom.Web.Pages.Yonetim.Fiyatlandirma.KoltuklarModel
@using System.Text.Json
@using ConferenceRoom.Web.Common
@*
    Etkinlik koltuk ayarları. Çerçeve (başlık, araçlar, tuval, seçim bölümü) ortak şablondan gelir (_SeatScreenLayout);
    burada panelin ekrana özgü bölümleri ve ekranın verisi var. İşleyiş wwwroot/js/koltuk-ayarlari.js.
    Panel metinlerini ekran kendisi üretir ("seatEditor" bölümü, #editorConfig içinde).
*@
@{
    Layout = "_SeatScreenLayout";
    ViewData["Title"] = $"{Model.EventTitle} · {T["seatEditor.appName"]}";
    ViewData["ScreenTitle"] = Model.EventTitle;
    ViewData["ScreenSubtitle"] = Model.HallName;
    ViewData["BackUrl"] = "/yonetim/fiyatlandirma";
    if (Model.PlanVersionCount > 1)
        ViewData["Notice"] = T["seatEditor.multiVersions"].Value;
    // Seansı olmayan etkinlikte hangi krokinin gösterileceği belli değil.
    if (Model.PlanJson is null)
        ViewData["EmptyMessage"] = T["seatMap.noSessions"].Value;
}
<section class="sec" id="catSec"></section>
<section class="sec" id="onlineSec"></section>
<section class="sec" id="statSec"></section>

@section Scripts {
    <script type="application/json" id="editorConfig">@Html.Raw(ScreenData.ForScript(JsonSerializer.Serialize(Model.EditorConfig)))</script>
    <script type="application/json" id="planData">@Html.Raw(ScreenData.ForScript(Model.PlanJson!))</script>
    <script type="application/json" id="seatData">@Html.Raw(ScreenData.ForScript(Model.MapJson))</script>
    <script src="~/js/koltuk-ayarlari.js" asp-append-version="true"></script>
}
