@*
    Ana şablon: başlık, dil seçici, içerik alanı ve alt bilgi.
    Görünüm tamamen wwwroot/css/site.css içindeki CSS değişkenlerinden gelir; tasarım değişince yalnızca o dosya değişir.
    Bu dosyada sabit metin yoktur, tüm metinler dil dosyalarından (@T["..."]) gelir.
*@
@using System.Globalization
@inject ConferenceRoom.Localization.LanguageCatalog Catalog
@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · @T["app.name"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-row">
            <a class="brand" href="/">@T["app.name"]</a>
            <nav class="main-nav" aria-label="@T["nav.home"]">
                <a href="/">@T["nav.home"]</a>
            </nav>
            <nav class="language-switch" aria-label="@T["nav.language"]">
                @foreach (var language in Catalog.Languages)
                {
                    <a href="/language/@language.Culture?returnUrl=@Uri.EscapeDataString(returnUrl)"
                       aria-current="@(language.Culture == currentCulture ? "true" : null)"
                       lang="@language.Culture">@language.Name</a>
                }
            </nav>
        </div>
    </header>

    <main class="container" id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">@T["app.name"] · @T["footer.license"]</div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
