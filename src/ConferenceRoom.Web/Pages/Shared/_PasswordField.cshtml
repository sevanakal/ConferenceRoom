@*
    Şifre alanı + göster/gizle düğmesi. Giriş ve kayıt formlarında ortak.
    Model: (alan adı/kimliği, autocomplete değeri, hata metni ya da null, ipucu metni ya da null)
*@
@model (string Name, string AutoComplete, string? Error, string? Hint)
@{
    var id = Model.Name.Replace('.', '_');   // "Input.Password" → "Input_Password" (ASP.NET'in kendi kimlik biçimi)
}
<div class="field">
    <label for="@id">@T["auth.password"]</label>
    <div class="password-wrap">
        <input id="@id" name="@Model.Name" type="password" autocomplete="@Model.AutoComplete" required
               aria-invalid="@(Model.Error is null ? null : "true")"
               aria-describedby="@(Model.Error is null ? (Model.Hint is null ? null : id + "-hint") : id + "-error")" />
        <button type="button" class="password-toggle" data-toggle-password="@id" aria-pressed="false"
                aria-label="@T["auth.showPassword"]" title="@T["auth.showPassword"]"
                data-show="@T["auth.showPassword"]" data-hide="@T["auth.hidePassword"]">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
        </button>
    </div>
    @if (Model.Error is not null)
    {
        <p class="field-error" id="@(id)-error">@Model.Error</p>
    }
    else if (Model.Hint is not null)
    {
        <p class="field-hint" id="@(id)-hint">@Model.Hint</p>
    }
</div>
