@page "/pano"
@model ConferenceRoom.Web.Pages.PanoModel
@using System.Globalization
@using ConferenceRoom.Web.Common
@using ConferenceRoom.Web.Events
@*
    Etkinlik panosu: lobideki ekranda ya da telefonda açılabilen, giriş istemeyen bilgilendirme sayfası.
    Kendi şablonu vardır (genel menü yok); stil wwwroot/css/pano.css. Sayfa 60 saniyede bir yenilenir.
*@
@{
    Layout = null;
    var culture = CultureInfo.CurrentCulture;
    string DayTitle(DateOnly date) =>
        date == Model.Today ? T["board.today"]
        : date == Model.Today.AddDays(1) ? T["board.tomorrow"]
        : date.ToString("dddd, d MMMM", culture);
    string Time(DateTime utc) => DisplayTime.ToLocal(utc).ToString("HH:mm", culture);
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content="60" />
    <title>@T["board.title"] · @T["app.name"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pano.css" asp-append-version="true" />
</head>
<body class="board">
    <header class="board-head">
        <a class="board-brand" href="/"><partial name="_BrandMark" /><span>@T["app.name"]</span></a>
        <h1>@T["board.title"]</h1>
        <div class="board-clock">
            <time id="clock">@Model.NowLocal.ToString("HH:mm", culture)</time>
            <span>@Model.Today.ToString("d MMMM yyyy, dddd", culture)</span>
        </div>
    </header>

    <main class="board-main">
        @if (Model.Days.Count == 0)
        {
            <p class="board-empty">@T["board.empty"]</p>
        }
        @foreach (var day in Model.Days)
        {
            <section class="board-day">
                <h2>@DayTitle(day.Date)</h2>
                <ul class="board-list">
                    @foreach (var item in day.Items)
                    {
                        <li class="board-item" data-badge="@item.Badge">
                            <div class="board-time">
                                <strong>@Time(item.StartsAtUtc)</strong>
                                @if (item.EndsAtUtc is { } end)
                                {
                                    <span>– @Time(end)</span>
                                }
                            </div>
                            @if (item.PosterFileName is not null)
                            {
                                <img class="board-poster" src="@PosterStore.Url(item.PosterFileName)" alt="" loading="lazy" />
                            }
                            else
                            {
                                <div class="board-poster board-poster--empty" aria-hidden="true">@item.Title[..1]</div>
                            }
                            <div class="board-info">
                                <h3>@item.Title</h3>
                                <p>@item.TypeName · @item.HallName@(item.Organizer is null ? "" : " · " + item.Organizer)</p>
                                @if (item.DoorsOpenAtUtc is { } doors && item.Badge != BoardBadge.Cancelled)
                                {
                                    <p class="board-doors">@T["board.doorsOpen", Time(doors)]</p>
                                }
                            </div>
                            <span class="board-badge">
                                @if (item.Badge == BoardBadge.SalesSoon)
                                {
                                    @T["board.badgeSalesSoon", DisplayTime.Format(item.SalesStartUtc!.Value)]
                                }
                                else
                                {
                                    @T[$"board.badge{item.Badge}"]
                                }
                            </span>
                        </li>
                    }
                </ul>
            </section>
        }
    </main>

    <script>
        // Saat her 15 saniyede güncellenir (sayfa zaten dakikada bir yenileniyor). Türkiye saati sunucudan gelir; burada yalnızca ilerletilir.
        (function () {
            var el = document.getElementById("clock"), parts = el.textContent.split(":");
            var start = Date.now(), base = (+parts[0]) * 60 + (+parts[1]);
            setInterval(function () {
                var m = (base + Math.floor((Date.now() - start) / 60000)) % 1440;
                el.textContent = String(Math.floor(m / 60)).padStart(2, "0") + ":" + String(m % 60).padStart(2, "0");
            }, 15000);
        })();
    </script>
</body>
</html>
