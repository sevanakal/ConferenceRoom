<!--
  NuGet paket sürümleri tek yerden yönetilir (Central Package Management).
  .csproj dosyalarında PackageReference sürümsüz yazılır; sürüm yükseltmek için yalnızca burası değişir.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Veritabanı: EF Core 10 + Oracle'ın resmi MySQL sağlayıcısı (bkz. CLAUDE.md "Veritabanı sağlayıcısı") -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
    <!-- Satış raporunu Excel (.xlsx) dosyası olarak indirme (Web/Sales/SalesExcel.cs); MIT lisanslı -->
    <PackageVersion Include="ClosedXML" Version="0.105.0" />
    <!-- Dil kütüphanesi -->
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <!-- Testler -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
